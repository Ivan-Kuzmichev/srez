# Путь к файлу базы SQLite. В Docker не используется: compose ставит /data/srez.db на томе ./data
DATABASE_PATH=./data/srez.db

# Публичный адрес сервиса. Нужен для кук и пасскеев. Пасскеи работают только по HTTPS и по имени, не по IP.
APP_URL=https://invest.home.arpa

# Ключ шифрования секретов в базе: 32 байта в base64. Сгенерировать: openssl rand -base64 32
# Потеря ключа означает повторный ввод токенов.
APP_SECRET_KEY=

# Секрет библиотеки аутентификации. Сгенерировать: openssl rand -base64 32
AUTH_SECRET=

# Адреса обратных прокси, которым разрешено передавать X-Forwarded-For. Через запятую, можно CIDR.
TRUSTED_PROXIES=

# Необязательно. Прокси только для запросов к Т-Инвестициям: http://user:pass@host:port или socks5://host:port
TINVEST_PROXY_URL=

# Уровень логов до загрузки настроек из базы: debug, info, warn, error
LOG_LEVEL=info

TZ=UTC
